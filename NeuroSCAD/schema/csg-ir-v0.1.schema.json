{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroscad.dev/schema/csg-ir-v0.1.schema.json",
  "title": "NeuroSCAD CSG-IR v0.1",
  "type": "object", "required": ["version", "root", "nodes"],
  "properties": {
    "version": {"const": "0.1"}, "root": {"type": "string", "minLength": 1}, "metadata": {"type": "object"},
    "parameters": {"type": "array", "items": {"type": "object", "required": ["name", "default", "minimum", "maximum"], "properties": {
      "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "default": {"type": "number"}, "minimum": {"type": "number"}, "maximum": {"type": "number"}, "step": {"type": "number", "exclusiveMinimum": 0}, "unit": {"type": "string"}, "label": {"type": "string"}, "group": {"type": "string"}
    }, "additionalProperties": false}},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "op"], "properties": {
      "id": {"type": "string", "minLength": 1}, "op": {"enum": ["box", "cylinder", "sphere", "union", "difference", "intersection"]}, "children": {"type": "array", "items": {"type": "string"}}, "args": {"type": "object"}, "translate": {"type": "array", "minItems": 3, "maxItems": 3}, "rotate": {"type": "array", "minItems": 3, "maxItems": 3}, "role": {"type": "string"}
    }, "additionalProperties": false}}
  }, "additionalProperties": false
}
